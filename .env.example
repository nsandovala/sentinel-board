# Local-only AA operational snapshot bridge. Start AA with `npm run amon -- ops-server`.
# The SB dev script binds to 127.0.0.1; the bridge is disabled in production.
AMON_OPS_SNAPSHOT_URL=http://127.0.0.1:4785/api/ops/snapshot

# Clerk: configure a development instance for local QA. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AMON_OWNER_CLERK_USER_ID=
# Comma-separated exact origins. HTTPS required in production.
CLERK_AUTHORIZED_PARTIES=
# Exact public origin of this deployment, also present in CLERK_AUTHORIZED_PARTIES.
# Never use the internal listener address or derive this from request headers.
SENTINEL_PUBLIC_ORIGIN=
# Import-only service credential. Never prefix with NEXT_PUBLIC_.
AMON_IMPORT_TOKEN=
# Optional legacy import credential during consumer rotation; unset afterwards.
SENTINEL_API_TOKEN=
